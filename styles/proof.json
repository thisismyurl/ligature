{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "title": "Proof",
  "settings": {
    "custom": {
      "colophon-light": "#f8f4ec",
      "colophon-dark": "#141210",
      "colophon-accent": "#6e5410"
    },
    "color": {
      "palette": [
        {
          "slug": "lig-paper",
          "color": "#f8f4ec",
          "name": "Lig Paper"
        },
        {
          "slug": "lig-ink",
          "color": "#141210",
          "name": "Lig Ink"
        },
        {
          "slug": "lig-secondary",
          "color": "#2a2822",
          "name": "Lig Secondary"
        },
        {
          "slug": "lig-muted",
          "color": "#5a554a",
          "name": "Lig Muted"
        },
        {
          "slug": "lig-rule",
          "color": "#d8d0c0",
          "name": "Lig Rule"
        },
        {
          "slug": "lig-surface",
          "color": "#ede8dc",
          "name": "Lig Surface"
        },
        {
          "slug": "lig-overlay",
          "color": "#e4dece",
          "name": "Lig Overlay"
        },
        {
          "slug": "lig-signal",
          "color": "#6e5410",
          "name": "Lig Signal"
        },
        {
          "slug": "lig-signal-tint",
          "color": "#f5ecc0",
          "name": "Lig Signal Tint"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--lig-paper)",
      "text": "var(--wp--preset--color--lig-ink)"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--lig-ink)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--lig-signal)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--lig-ink)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--lig-ink)",
          "text": "var(--wp--preset--color--lig-paper)"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "color": {
          "text": "var(--wp--preset--color--lig-ink)"
        }
      },
      "core/navigation": {
        "color": {
          "text": "var(--wp--preset--color--lig-secondary)"
        }
      }
    }
  }
}